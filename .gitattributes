<!DOCTYPE html>
<html>
<head>
    <title>Миний үнэгүй зар</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f0f2f5;
            margin: 0;
            padding: 20px;
        }
        
        .container {
            max-width: 600px;
            margin: auto;
        }
        
        h1 {
            text-align: center;
            color: #1877f2;
        }
        
        .form-box {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        input, textarea {
            width: 100%;
            margin: 5px 0;
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        
        button {
            padding: 8px 12px;
            background: #1877f2;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        
        button:hover {
            background: #145dbf;
        }
        
        .ad {
            background: white;
            padding: 15px;
            margin-top: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .ad img {
            width: 100%;
            margin-top: 10px;
            border-radius: 8px;
        }
        </style>
</head>
<body>

<h1>Үнэгүй Зар</h1>

<input type="text" id="search" placeholder="Зар хайх" onkeyup="searchAd()">
<input type="text" id="title" placeholder="Гарчиг">
<input type="text" id="price" placeholder="Үнэ">
<input type="file" id="image">
<textarea id="description" placeholder="Тайлбар"></textarea>
<button onclick="addAd()">Зар нэмэх</button>

<hr>

<div id="ads"></div>

<script>
    let ads = JSON.parse(localStorage.getItem("ads")) || [];
    
    function saveAds() {
        localStorage.setItem("ads", JSON.stringify(ads));
    }
    
    function displayAds() {
        document.getElementById("ads").innerHTML = "";
        ads.forEach((ad, index) => {
            let adDiv = document.createElement("div");
            adDiv.className = "ad";
    
            adDiv.innerHTML = `
                <h3>${ad.title}</h3>
                <p><b>Үнэ:</b> ${ad.price}₮</p>
                ${ad.image ? `<img src="${ad.image}" width="100%">` : ""}
                <p>${ad.description}</p>
                <button onclick="deleteAd(${index})">Устгах</button>
            `;
    
            document.getElementById("ads").appendChild(adDiv);
        });
    }
    
    function addAd() {
        let title = document.getElementById("title").value;
        let price = document.getElementById("price").value;
        let description = document.getElementById("description").value;
        let imageInput = document.getElementById("image");
    
        if(title === "" || price === "") {
            alert("Гарчиг болон үнийг бөглөнө үү!");
            return;
        }
    
        let reader = new FileReader();
    
        reader.onload = function() {
            ads.push({
                title: title,
                price: price,
                description: description,
                image: reader.result
            });
    
            saveAds();
            displayAds();
        };
    
        if(imageInput.files[0]) {
            reader.readAsDataURL(imageInput.files[0]);
        } else {
            ads.push({ title, price, description, image: null });
            saveAds();
            displayAds();
        }
    
        document.getElementById("title").value = "";
        document.getElementById("price").value = "";
        document.getElementById("description").value = "";
        imageInput.value = "";
    }
    
    function deleteAd(index) {
        ads.splice(index, 1);
        saveAds();
        displayAds();
    }
    
    displayAds();
    function searchAd() {
    let filter = document.getElementById("search").value.toLowerCase();
    let adDivs = document.getElementById("ads").children;

    for (let i = 0; i < adDivs.length; i++) {
        let ad = ads[i];
        if (
            ad.title.toLowerCase().includes(filter) ||
            ad.price.toLowerCase().includes(filter) ||
            (ad.description && ad.description.toLowerCase().includes(filter))
        ) {
            adDivs[i].style.display = "block";
        } else {
            adDivs[i].style.display = "none";
        }
    }
}
    </script>
</body>
</html>
